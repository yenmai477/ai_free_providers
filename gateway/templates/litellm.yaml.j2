model_list:
{% for name, display in aliases %}
  - model_name: {{ name }}
    litellm_params:
      model: ollama_chat/{{ ollama_model }}
      api_base: http://127.0.0.1:11434
      api_key: ollama
{% if disable_think %}
      think: false
{% endif %}
{% if display %}
    model_info:
      display_name: "{{ display }}"
{% endif %}
{% endfor %}
general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
